{
  "name": "bardic-torch-api",
  "cron": [
    {
      "command": "/app/check-links",
      "schedule": "23 3 * * *"
    }
  ],
  "scripts": {
    "dokku": {
      "predeploy": "/app/migrate up"
    }
  },
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "readyz",
        "description": "The API is serving and can reach MySQL",
        "path": "/readyz",
        "attempts": 5,
        "wait": 2,
        "timeout": 5
      }
    ]
  }
}
