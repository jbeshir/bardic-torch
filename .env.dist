# Minimum level of log entries to write: DEBUG, INFO, WARN or ERROR.
LOG_LEVEL=DEBUG

# Port the HTTP server listens on. dokku sets this in production.
PORT=5000

# MySQL connection URL, in the form the dokku mysql plugin sets: mysql://user:password@host:port/database.
DATABASE_URL=mysql://bardic_torch:pass@127.0.0.1:3306/bardic_torch

# Comma-separated authentication drivers: auth0 (Auth0 access tokens) and api_token (personal API tokens). Empty
# means no authentication: every request is anonymous and authenticated endpoints answer 401.
AUTH_DRIVERS=

# The Auth0 tenant's domain (its custom domain if it has one), which issues access tokens. Read only when
# AUTH_DRIVERS includes auth0.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# The identifier of the Auth0 API that access tokens must be issued for. Read only when AUTH_DRIVERS includes
# auth0.
AUTH0_AUDIENCE=https://api.bardictorch.org

# Comma-separated IDs of users to make moderators at startup, as Auth0 shows them (e.g. google-oauth2|123).
# Missing users are created and blocked users are unblocked. Removing an ID never demotes the user; demote them
# in the database instead. May be empty.
BOOTSTRAP_MODERATOR_USER_IDS=

# The secret key of the contact form's Cloudflare Turnstile widget, which verifies its tokens server-side. Empty
# disables the contact form: POST /v1/contact answers 503. The default is Cloudflare's always-passing test secret,
# for development; its other test secrets are 2x0000000000000000000000000000000AA (always fails) and
# 3x0000000000000000000000000000000AA (token already spent). The FE's matching test site keys are
# 1x00000000000000000000AA (passes), 2x00000000000000000000AB (blocks) and 3x00000000000000000000FF (forces an
# interactive challenge); they produce the dummy token XXXX.DUMMY.TOKEN.XXXX. Test secrets still call Cloudflare,
# and may answer an action other than "contact", so locally POST /v1/contact can be 400 turnstile_failed. The action
# check is never weakened by a variable; an exemption would be tied to the exact dummy secret value and needs a
# docs/PLAN.md edit.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated hostnames a Turnstile token must have been minted on, compared case-insensitively (production
# and staging: bardictorch.org,preview.bardictorch.org). Empty disables the hostname check, for development only
# (the API logs a warning at startup), as the test secret's tokens may report a hostname that is not yours. Tokens
# must always be minted for the action "contact".
TURNSTILE_HOSTNAMES=

# Comma-separated networks, in CIDR notation, of the reverse proxies trusted to report the client's IP: a request
# from one of them is from the last address in its last X-Forwarded-For header, and X-Forwarded-For from any other
# peer is ignored. Production: 172.16.0.0/12, dokku's nginx on the docker bridge network. Empty trusts no proxy
# (the API logs a warning at startup). The contact form's rate limits are per client IP.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# The secret the FE sends in X-Bardic-Proxy-Secret, with the browser's IP in X-Bardic-Client-IP, on its server-side
# API calls, so that contact form messages are limited per browser rather than per FE server. Set the same value
# on the FE. Empty attributes no request (the API logs a warning at startup), so every message is limited by the
# looser limit for IPs the FE did not attribute. Never commit a real value.
FE_PROXY_SECRET=
